<Window x:Class="SlopBegone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SlopBegone"
        mc:Ignorable="d"
        Title="AI slop begone" Height="160" Width="600" ResizeMode="NoResize" Background="#1e1e1e">
    <Grid>
        <StackPanel>
            <Label Content="This will remove recall and copilot" FontSize="24" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>
            <Border Margin="8" Padding="4"  CornerRadius="5" Background="#4a4a4a">
                    <Button x:Name="RemoveSlop" Content="Nuke slop" Margin="8" Padding="10" Click="RemoveSlop_Click"/>
            </Border>

        </StackPanel>
    </Grid>
</Window>
